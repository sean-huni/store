# =============================================================================
# STAGE 1: Dependencies Layer (shared with regular Dockerfile for consistency)
# =============================================================================
FROM alpine:3.22.2 AS deps-builder

# Install minimal runtime dependencies for native builds
RUN apk add --no-cache \
        ca-certificates \
        tzdata \
        dumb-init \
        curl \
        libc6-compat && \
    # Clean up APK cache \
    rm -rf /var/cache/apk/* && \
    # Setup timezone for UTC (cloud standard) \
    ln -snf /usr/share/zoneinfo/UTC /etc/localtime && \
    echo "UTC" > /etc/timezone

# =============================================================================
# STAGE 2: Native Build Stage (GraalVM Native Image Compilation)
# =============================================================================
FROM ghcr.io/graalvm/graalvm-community:25-jdk-jammy AS native-builder

WORKDIR /build

# Install build dependencies for native compilation
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        zlib1g-dev \
        libssl-dev && \
    rm -rf /var/lib/apt/lists/*

# Copy build files (ordered by change frequency for better caching)
COPY gradle gradle
COPY gradlew .
COPY settings.gradle .
COPY jacoco.gradle .
COPY build.gradle .

# Copy source code (changes most frequently, so copied last)
COPY src src

# Enhanced build-time memory and performance settings for native compilation
ENV JAVA_OPTS="-Xmx14g -XX:MaxMetaspaceSize=3g"
ENV JAVA_TOOL_OPTIONS="-Duser.timezone=UTC -Dfile.encoding=UTF-8 -Djava.security.egd=file:/dev/./urandom -Dspring.backgroundpreinitializer.ignore=true"

# Make gradlew executable
RUN chmod +x ./gradlew

# Build the native image with enhanced container-aware settings
# Optimized for cloud deployments with better performance and smaller size
RUN ./gradlew nativeCompile \
    -Porg.gradle.java.installations.auto-download=false \
    -Dspring.native.mode=reflection \
    -Dspring.native.verbose=true \
    -Dorg.gradle.jvmargs="-Xmx14g -XX:MaxMetaspaceSize=3g -XX:+UseContainerSupport -XX:+UseZGC" \
    -Dorg.gradle.workers.max=4 \
    -Dorg.gradle.parallel=true \
    -Dorg.gradle.caching=true \
    -Dorg.graalvm.nativeimage.imagecode=1 \
    -Dorg.graalvm.nativeimage.native-image-args="--gc=serial -march=native -Ob --no-fallback --enable-url-protocols=http,https --enable-monitoring=heapdump,jfr --initialize-at-build-time=org.slf4j,ch.qos.logback -H:+ReportExceptionStackTraces -H:+AddAllCharsets" \
    --no-daemon

# =============================================================================
# STAGE 3: Final Native Runtime Image (Ultra-minimal & Secure)
# =============================================================================
FROM alpine:3.22.2

# Metadata for cloud deployments
LABEL maintainer="store-app-team" \
      version="2.0.0" \
      description="Multi-stage GraalVM native Spring Boot application for cloud deployments" \
      java.version="25-native" \
      gc.collector="Serial" \
      optimization="graalvm-native-multi-stage" \
      architecture="native-graalvm"

# Security: Add app user with proper UID for K8s security contexts
ARG APPLICATION_USER=appuser
ARG APPLICATION_UID=1000
ARG APPLICATION_GID=1000

# Build argument for Spring Profiles (fixes undefined variable warning)
ARG SPRING_PROFILES_ACTIVE=native

# Create user and group (no shell for security)
RUN addgroup -g ${APPLICATION_GID} -S ${APPLICATION_USER} && \
    adduser -u ${APPLICATION_UID} -S ${APPLICATION_USER} -G ${APPLICATION_USER} -s /sbin/nologin

# Copy minimal dependencies from deps stage
COPY --from=deps-builder /usr/bin/dumb-init /usr/bin/dumb-init
COPY --from=deps-builder /usr/bin/curl /usr/bin/curl
COPY --from=deps-builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=deps-builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=deps-builder /etc/localtime /etc/localtime
COPY --from=deps-builder /etc/timezone /etc/timezone

# Install minimal libc6-compat for native executable compatibility
RUN apk add --no-cache libc6-compat && rm -rf /var/cache/apk/*

# Container memory optimizations for native executables
ENV MALLOC_ARENA_MAX=1
ENV MALLOC_TRIM_THRESHOLD_=65536
ENV MALLOC_TOP_PAD_=65536

# Cloud deployment environment variables
ENV SPRING_PROFILES_ACTIVE=${SPRING_PROFILES_ACTIVE:-native}
ENV SERVER_SHUTDOWN=graceful
ENV SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=30s

# Native-specific performance tuning
ENV SPRING_NATIVE=true
ENV GRAALVM_NATIVE_IMAGE=true

# Create application directories with proper ownership
RUN mkdir -p /app /tmp/heapdumps /app/logs && \
    chown -R ${APPLICATION_UID}:${APPLICATION_GID} /app /tmp/heapdumps

# Copy native executable with proper ownership (this layer changes most frequently)
COPY --from=native-builder --chown=${APPLICATION_UID}:${APPLICATION_GID} /build/build/native/nativeCompile/store /app/store

# Switch to non-root user for security
USER ${APPLICATION_UID}:${APPLICATION_GID}
WORKDIR /app

# Verify native executable is working (fail fast if build was broken)
RUN ./store --version || echo "Native executable ready (version check not available)"

# Lightweight health check (no bash dependency, native-executable friendly)
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -f http://localhost:8080/actuator/health || exit 1

# Expose application port for K8s service discovery
EXPOSE 8080

# Optimized ENTRYPOINT for native executable with enhanced configurations
# Native executables don't use JVM flags but can receive environment variables
# Configuration includes:
# - dumb-init for proper signal handling in containers
# - Graceful shutdown configuration via environment variables
# - Cloud deployment readiness
# - Monitoring and observability endpoint exposure
# - Production-ready security settings
ENTRYPOINT ["dumb-init", "--", "./store"]