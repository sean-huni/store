<?xml version="1.0"?>

<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- Suppress magic number warning for validation annotation parameters -->
    <suppress checks="MagicNumber"
              files="*.java"/>

    <!-- Suppress all checks for @Generated classes -->
    <suppress checks=".*"
              files=".*Generated.*\.java"/>

    <!-- Suppress all checks for generated source files -->
    <suppress checks=".*"
              files=".*/build/generated/.*"/>
</suppressions>